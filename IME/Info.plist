<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>玫枫五笔</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>玫枫五笔</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Finder「输入法」目录展示用（与主 App 同款） -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>cn.kylebing.inputmethod.meifengwubi.wubi</key>
			<dict>
				<key>TISIconLabels</key>
				<dict>
					<!-- 无图标时的文字回退；正式名称走 InfoPlist.strings -->
					<key>Primary</key>
					<string>玫枫</string>
				</dict>
				<key>TISInputSourceID</key>
				<string>cn.kylebing.inputmethod.meifengwubi.wubi</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<!-- 状态栏：桌面枫叶图的 16/32 px 模板 TIFF -->
				<key>tsInputModeMenuIconFileKey</key>
				<string>ime-menu.tiff</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>ime-selected.tiff</string>
				<!-- Fn/地球键切换器通常读取模式的面板图标 -->
				<key>tsInputModePaletteIconFileKey</key>
				<string>ime-fn.tiff</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
					<string>Latn</string>
				</array>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<!-- 与系统五笔一致：不抢简体中文主输入法位，避免切换异常 -->
				<key>tsInputModePrimaryInScriptKey</key>
				<false/>
				<key>tsInputModeScriptKey</key>
				<string>smSimpChinese</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>cn.kylebing.inputmethod.meifengwubi.wubi</string>
		</array>
	</dict>
	<key>InputMethodConnectionName</key>
	<string>MeifengWubi_1_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>MeifengInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>MeifengInputController</string>
	<key>InputMethodServerPreferencesWindowControllerClass</key>
	<string>MeifengPreferencesWindowController</string>
	<key>LSBackgroundOnly</key>
	<false/>
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<!-- 图标自带浅色描边，选中态不再当成模板反色，避免浅底上变成看不见的白图 -->
	<key>TISIconIsTemplate</key>
	<false/>
	<key>TISIconLabels</key>
	<dict>
		<key>Primary</key>
		<string>玫枫</string>
	</dict>
	<key>TISInputSourceID</key>
	<string>cn.kylebing.inputmethod.meifengwubi</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
		<string>Latn</string>
	</array>
	<!-- Input Sources 列表使用方法级图标 -->
	<key>tsInputMethodIconFileKey</key>
	<string>ime-input-source.tiff</string>
	<key>tsInputMethodAlternateIconFileKey</key>
	<string>ime-selected.tiff</string>
	<key>tsInputMethodPaletteIconFileKey</key>
	<string>ime-fn.tiff</string>
</dict>
</plist>
